# Copy to .env and adjust. Never commit .env.
# Local development credentials only. Not for any shared or real environment.
POSTGRES_USER=smartpbl
POSTGRES_PASSWORD=smartpbl
POSTGRES_DB=smartpbl

SMARTPBL_ENVIRONMENT=local
SMARTPBL_DATABASE_URL=postgresql+psycopg://smartpbl:smartpbl@localhost:5442/smartpbl
SMARTPBL_OLLAMA_BASE_URL=http://localhost:11434
# Default model; qwen2.5:3b is also pulled for size-vs-quality comparison.
SMARTPBL_LLM_MODEL=llama3.1:8b
SMARTPBL_LLM_TIMEOUT_S=60
SMARTPBL_LLM_SEED=42
SMARTPBL_EXTRACTION_PROMPT_VERSION=v2
# HMAC key for audit-log input hashes. Generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
SMARTPBL_AUDIT_HASH_KEY=dev-only-not-secret
